# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# The whole framework runs with the values below (no credentials required).
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# mock | openai
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Application under test -------------------------------------------------
APP_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000/api
APP_AUTO_START=true

# --- Test user --------------------------------------------------------------
TEST_USER_EMAIL=customer@example.com
TEST_USER_PASSWORD=Passw0rd!

# --- Evaluation -------------------------------------------------------------
# deepeval | ragas | builtin | auto  (auto = use what is installed)
EVALUATOR_BACKEND=auto
EVAL_MODEL=gpt-4o-mini

# --- Observability (optional) ----------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Playwright -------------------------------------------------------------
HEADLESS=true
BROWSER=chromium
SLOW_MO=0
